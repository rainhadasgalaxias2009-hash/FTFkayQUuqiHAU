if tab=="H" then applyKind(target,"H",it)
elseif tab=="G" then applyKind(target,"G",it)
else applyKind(target,"H",it.h) applyKind(target,"G",it.g) end
refreshPlayers() updateStatus()
end
local function img(parent,thumb,pos,size)
