else
mk("TextLabel",{BackgroundTransparency=1,Position=U(0,4,0,2),Size=U(1,-8,0,24),Text=it.name,Font=Enum.Font.GothamBold,TextSize=10,TextColor3=C.text,TextWrapped=true,TextTruncate=Enum.TextTruncate.AtEnd},b)
img(b,it.thumb,U(0,4,0,28),U(1,-8,1,-32))
end
b.Activated:Connect(function() onPick(it) end)
end
local function renderMore()
if busy then return end
busy=true
if moreBtn then moreBtn:Destroy() moreBtn=nil end
local my=token
local stop=math.min(shown+PAGE,#filtered)
for i=shown+1,stop do
if my~=token or not guiAlive then busy=false return end
makeCell(filtered[i],i)
if i%10==0 then task.wait() end
end
if not guiAlive then busy=false return end
shown=stop
if shown<#filtered then
moreBtn=mk("TextButton",{LayoutOrder=1e6,BackgroundColor3=C.btn,Text="Mostrar mais ("..(#filtered-shown)..")",Font=Enum.Font.GothamBold,TextSize=11,TextColor3=C.text,BorderSizePixel=0,TextWrapped=true},grid)
corner(moreBtn,8)
moreBtn.Activated:Connect(renderMore)
end
busy=false
end
local function runSearch()
token+=1
busy=false
for _,c in ipairs(grid:GetChildren()) do if c:IsA("GuiObject") then c:Destroy() end end
moreBtn=nil
gl.CellSize=(tab=="S") and U(.5,-6,0,122) or U(1/3,-6,0,112)
local q=(search.Text:lower():gsub("^%s+",""):gsub("%s+$",""))
local src=srcOf(tab)
filtered={}
for _,it in ipairs(src) do
if (not fEvent or it.ev==fEvent) and (not fRar or it.rar==fRar) then
local hay=(tab=="S") and (it.h.name:lower().." "..it.g.name:lower().." "..it.id:lower().." "..it.ev:lower()) or (it.name:lower().." "..it.id:lower().." "..it.ev:lower())
if q=="" or hay:find(q,1,true) then filtered[#filtered+1]=it end
end
end
shown=0
grid.CanvasPosition=Vector2.new(0,0)
renderMore()
end

-- filtros
function refreshFilterBtns()
bEv.Text="Evento: "..(fEvent or "Todos").." v"
bRa.Text="Raridade: "..(fRar~=nil and (RARN[fRar] or tostring(fRar)) or "Todos").." v"
bRa.TextColor3=(fRar~=nil and RAR[fRar]) or C.text
end
local ddWhich=nil
function closeDD() dd.Visible=false ddWhich=nil end
local function openDD(which)
if ddWhich==which then closeDD() return end
for _,c in ipairs(dd:GetChildren()) do if c:IsA("TextButton") then c:Destroy() end end
local ec,rc=stats(tab)
local opts={{label="Todos",val=nil}}
if which=="E" then
local list={}
for name,n in pairs(ec) do list[#list+1]={name=name,n=n} end
table.sort(list,function(a,b)
local ra,rb=evRank(a.name),evRank(b.name)
if ra~=rb then return ra<rb end
if a.n~=b.n then return a.n>b.n end
return a.name<b.name
end)
for _,e in ipairs(list) do opts[#opts+1]={label=e.name.." ("..e.n..")",val=e.name} end
else
local ks={}
for r,_ in pairs(rc) do ks[#ks+1]=r end
table.sort(ks,function(a,b) return rarRank(a)<rarRank(b) end)
for _,r in ipairs(ks) do opts[#opts+1]={label=(RARN[r] or tostring(r)).." ("..rc[r]..")",val=r,col=RAR[r]} end
end
local cur=(which=="E") and fEvent or fRar
for i,o in ipairs(opts) do
local b=mk("TextButton",{LayoutOrder=i,Size=U(1,0,0,24),BackgroundColor3=(o.val==cur) and C.btn or C.card,Text=o.label,Font=Enum.Font.GothamBold,TextSize=12,TextColor3=o.col or C.text,BorderSizePixel=0,ZIndex=11},dd)
corner(b,6)
b.Activated:Connect(function()
if which=="E" then fEvent=o.val else fRar=o.val end
closeDD() refreshFilterBtns() runSearch()
end)
end
dd.CanvasPosition=Vector2.new(0,0)
ddWhich=which
dd.Visible=true
end
bEv.Activated:Connect(function() openDD("E") end)
bRa.Activated:Connect(function() openDD("R") end)

local function setTab(k)
tab=k
closeDD()
local ec,rc=stats(k)
if fEvent and not ec[fEvent] then fEvent=nil end
if fRar~=nil and not rc[fRar] then fRar=nil end
refreshFilterBtns()
for key,b in pairs(tabBtns) do b.BackgroundColor3=(key==k) and C.btn or C.card end
runSearch()
end
for key,b in pairs(tabBtns) do b.Activated:Connect(function() setTab(key) end) end

