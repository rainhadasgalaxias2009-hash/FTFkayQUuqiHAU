local function updateStatus()
local a=applied[target.UserId]
local nm=(target==LP) and (LP.Name.." (eu)") or target.Name
local md=a and (a.mode.H or a.mode.G)
local tag=(md=="hand" or md=="inplace") and " [Besta]" or ""
