-- acha o objeto real do jogo (Besta: Hammer / Gemstone | Sobrevivente: Packed)
local function findReal(plr,kind)
local char=plr.Character
if not char then return nil end
if kind=="H" then
local bp=plr:FindFirstChild("Backpack")
local t=char:FindFirstChild("Hammer") or (bp and bp:FindFirstChild("Hammer"))
local h=t and t:FindFirstChild("Handle")
if h and h:IsA("BasePart") then return "hand",t,h end
else
local g=char:FindFirstChild("Gemstone")
local h=g and g:FindFirstChild("Handle")
if h and h:IsA("BasePart") then return "inplace",g,h end
end
return "back",char:FindFirstChild(PACKED[kind])
end

