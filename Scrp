local function clean(s)
s=tostring(s)
s=s:gsub("\u{2019}","'"):gsub("\u{2018}","'"):gsub("\u{201C}",'"'):gsub("\u{201D}",'"')
s=s:gsub("\u{F6}","o"):gsub("\u{F1}","n"):gsub("\u{E9}","e")
s=s:gsub("[\128-\255]","")
return s
end

-- EVENTOS (ordem = prioridade no topo)
local NOEV="Sem evento"
local OTHER="Outros"
local EVENTS={
{code="HAL",name="Halloween"},
{code="MAS",name="Natal"},
{code="ANI",name="Aniversario"},
{code="SUM",name="Verao"},
{code="SPR",name="Primavera"},
{code="AUT",name="Outono"},
{code="EAS",name="Pascoa"},
{code="LNY",name="Ano Novo Lunar"},
{code="VAL",name="Valentine"},
{code="PAT",name="Dia de S. Patricio"},
{code="VIP",name="VIP"},
}
local BYCODE,EVRANK={}, {}
for i,e in ipairs(EVENTS) do BYCODE[e.code]=e.name EVRANK[e.name]=i end
local function evRank(ev)
if ev==NOEV then return 1000 end
if ev==OTHER then return 900 end
return EVRANK[ev] or 800
end
local function matchEvent(s)
s=tostring(s)
local up=s:upper()
if BYCODE[up] then return BYCODE[up] end
local lo=s:lower()
for _,e in ipairs(EVENTS) do
if lo==e.name:lower() then return e.name end
end
return nil
end
local function eventOf(m,id)
-- 1) letras do ID (ex: HAL001, MAS002)
local pre=id:sub(2):match("^(%u+)%d")
if pre then return BYCODE[pre] or OTHER end
-- 2) atributo com "event" no nome
local okA,attrs=pcall(function() return m:GetAttributes() end)
if okA and attrs then
for k,v in pairs(attrs) do
if type(v)=="string" and v~="" and k:lower():find("event",1,true) then
local r=matchEvent(v)
if r then return r end
end
end
end
return NOEV
end

