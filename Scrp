local function cmp(a,b)
if a.def~=b.def then return a.def end
local ra,rb=rarRank(a.rar),rarRank(b.rar)
if ra~=rb then return ra<rb end
local ea,eb=evRank(a.ev),evRank(b.ev)
if ea~=eb then return ea<eb end
if a.ev~=b.ev then return a.ev<b.ev end
return a.id<b.id
end
