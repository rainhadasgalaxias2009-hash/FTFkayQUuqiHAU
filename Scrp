-- desconecta os vigias ANTES de devolver o visual original
local function restore(a,kind)
if a.hidConn[kind] then for _,c in ipairs(a.hidConn[kind]) do pcall(function() c:Disconnect() end) end end
a.hidConn[kind]=nil
local h=a.hid[kind]
a.hid[kind]=nil
if h then for d,t in pairs(h) do if d and d.Parent then d.Transparency=t end end end
local l=a.lights[kind]
if l then
for light,o in pairs(l) do
if light and light.Parent then for k,v in pairs(o) do pcall(function() light[k]=v end) end end
end
end
a.lights[kind]=nil
end

local function cleanup(a,kind)
if a.models[kind.."L"] then a.models[kind.."L"]:Destroy() a.models[kind.."L"]=nil end
if a.models[kind] then a.models[kind]:Destroy() a.models[kind]=nil end
if a.welds[kind] then
for _,w in ipairs(a.welds[kind]) do pcall(function() w:Destroy() end) end
a.welds[kind]=nil
end
restore(a,kind)
a.lightRef[kind]=nil
a.anchor[kind]=nil
a.real[kind]=nil a.mode[kind]=nil
end

-- esconde o visual original (so no seu cliente)
local function hideReal(a,kind,root,exclude,keepLights)
if not root then return end
a.hid[kind]=a.hid[kind] or {}
a.hidConn[kind]=a.hidConn[kind] or {}
a.lights[kind]=a.lights[kind] or {}
for _,d in ipairs(root:GetDescendants()) do
if not (exclude and d:IsDescendantOf(exclude)) then
if d:IsA("BasePart") then
if a.hid[kind][d]==nil then
a.hid[kind][d]=d.Transparency
table.insert(a.hidConn[kind],d:GetPropertyChangedSignal("Transparency"):Connect(function()
if a.hid[kind] and a.hid[kind][d]~=nil and d.Transparency~=1 then d.Transparency=1 end
end))
end
if d.Transparency~=1 then d.Transparency=1 end
elseif d:IsA("Light") and not keepLights then
if not a.lights[kind][d] then
a.lights[kind][d]={Enabled=d.Enabled}
table.insert(a.hidConn[kind],d:GetPropertyChangedSignal("Enabled"):Connect(function()
if d.Enabled then d.Enabled=false end
end))
end
if d.Enabled then d.Enabled=false end
end
end
end
end

local function prepParts(clone)
for _,d in ipairs(clone:GetDescendants()) do
if d:IsA("BasePart") then
d.Anchored=false d.CanCollide=false d.CanTouch=false d.CanQuery=false d.Massless=true
elseif d:IsA("LuaSourceContainer") then d:Destroy() end
end
end

local function vol(p) return p.Size.X*p.Size.Y*p.Size.Z end

-- posicoes de todas as pecas relativas a Handle do clone (seguindo os welds)
local function jointPoses(clone,cH)
local poses={[cH]=CFrame.new()}
local joints={}
for _,w in ipairs(clone:GetDescendants()) do
if w:IsA("JointInstance") and w.Part0 and w.Part1 then joints[#joints+1]=w end
end
local changed,guard=true,0
while changed and guard<30 do
changed=false guard+=1
for _,w in ipairs(joints) do
local p0,p1=poses[w.Part0],poses[w.Part1]
if p0 and not p1 then poses[w.Part1]=p0*w.C0*w.C1:Inverse() changed=true
elseif p1 and not p0 then poses[w.Part0]=p1*w.C1*w.C0:Inverse() changed=true end
end
end
return poses
end

-- peca visual extra da gema REAL (Gemstone > Gem > MeshPart), se existir
local function gemRef(root)
local gm=root:FindFirstChild("Gem")
if not gm then return nil end
if gm:IsA("BasePart") then return gm end
local best,bv
for _,d in ipairs(gm:GetDescendants()) do
if d:IsA("BasePart") then
local v=vol(d)
if not bv or v>bv then best,bv=d,v end
end
end
return best
end

local function addWeld(a,kind,p0,p1,c0,c1)
local w=mk("Weld",{Name="SkinWeld",Part0=p0,Part1=p1,C0=c0,C1=c1 or CFrame.new()},p0)
a.welds[kind]=a.welds[kind] or {}
table.insert(a.welds[kind],w)
return w
end

-- luz (usada na marreta): copia do item novo para a luz real e trava
local function setupLight(a,kind,clone,cH,realHandle,tint)
a.lights[kind]=a.lights[kind] or {}
a.hidConn[kind]=a.hidConn[kind] or {}
local newL=cH:FindFirstChildWhichIsA("Light") or clone:FindFirstChildWhichIsA("Light",true)
local realL=realHandle:FindFirstChildWhichIsA("Light")
local vals={}
if newL then
for _,p in ipairs(LPROPS) do pcall(function() vals[p]=newL[p] end) end
elseif tint and realL then
vals.Color=tint
else
return
end
local tl=realL
if not tl then
if not newL then return end
tl=newL:Clone()
tl.Parent=realHandle
a.models[kind.."L"]=tl
else
local o={}
for _,p in ipairs(LPROPS) do pcall(function() o[p]=tl[p] end) end
a.lights[kind][tl]=o
end
for p,v in pairs(vals) do
pcall(function() tl[p]=v end)
pcall(function()
table.insert(a.hidConn[kind],tl:GetPropertyChangedSignal(p):Connect(function()
if tl[p]~=v then tl[p]=v end
end))
end)
end
a.lightRef[kind]=tl
end

local function build(plr,a,kind)
local char=plr.Character
local item=a[kind]
if not char or not item then return false end
cleanup(a,kind)
a.hid[kind]=a.hid[kind] or {}
a.hidConn[kind]=a.hidConn[kind] or {}
a.lights[kind]=a.lights[kind] or {}
local mode,root,realHandle=findReal(plr,kind)

if mode=="hand" or mode=="inplace" then
-- na Besta usa o "Model" do item (tamanho e luz certos), nao o AccessoryModel das costas
local src=item.model:FindFirstChild("Model") or item.model:FindFirstChild("AccessoryModel")
if not src then return false end
local clone=src:Clone()
local cH=clone:FindFirstChild("Handle")
if not cH then clone:Destroy() return false end
prepParts(clone)

if kind=="G" then
-- GEMA (Besta): solda direto na peca visual da gema real
local ref=gemRef(root)
local anchor=ref or realHandle
local s=1
local os_=realHandle:FindFirstChild("OriginalSize")
if os_ and os_:IsA("Vector3Value") and os_.Value.Y>0 then
local r=realHandle.Size.Y/os_.Value.Y
if r>0.05 and r<20 then s=r end
end
local poses=jointPoses(clone,cH)
local offs={}
for _,d in ipairs(clone:GetDescendants()) do
if d:IsA("BasePart") then
offs[d]=poses[d] or cH.CFrame:ToObjectSpace(d.CFrame)
end
end
for _,d in ipairs(clone:GetDescendants()) do
if d:IsA("JointInstance") then d:Destroy() end
end
for d,o in pairs(offs) do
if s~=1 then
d.Size=d.Size*s
o=CFrame.new(o.Position*s)*(o-o.Position)
end
addWeld(a,kind,anchor,d,o,CFrame.new())
end
a.anchor[kind]=anchor
local newL=cH:FindFirstChildWhichIsA("Light") or clone:FindFirstChildWhichIsA("Light",true)
local realL=realHandle:FindFirstChildWhichIsA("Light")
if not newL and realL then
newL=Instance.new("PointLight")
newL.Color=cH.Color
newL.Brightness=realL.Brightness
newL.Range=realL.Range
newL.Shadows=false
newL.Parent=cH
end
if newL then newL.Enabled=true end
else
-- MARRETA: religa as pecas na Handle REAL com as posicoes do banco
for _,w in ipairs(clone:GetDescendants()) do
if w:IsA("JointInstance") then
if w.Part0==cH and w.Part1 and w.Part1~=cH then
addWeld(a,kind,realHandle,w.Part1,w.C0,w.C1)
elseif w.Part1==cH and w.Part0 and w.Part0~=cH then
addWeld(a,kind,realHandle,w.Part0,w.C1,w.C0)
end
end
end
setupLight(a,kind,clone,cH,realHandle,nil)
cH:Destroy()
end

clone.Name="Skin"..kind
clone.Parent=root
a.models[kind]=clone
hideReal(a,kind,root,clone,kind=="H")
a.real[kind]=root a.mode[kind]=mode
return true
end

-- modo costas (sobrevivente)
local src=item.model:FindFirstChild("AccessoryModel")
if not src then return false end
local clone=src:Clone()
local handle=clone:FindFirstChild("Handle")
if not handle then clone:Destroy() return false end
