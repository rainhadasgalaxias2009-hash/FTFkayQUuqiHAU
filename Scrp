local function makeCell(it,order)
local b=mk("TextButton",{LayoutOrder=order,BackgroundColor3=C.card,Text="",AutoButtonColor=true,BorderSizePixel=0},grid)
corner(b,8) stroke(b,RAR[it.rar] or C.border,1.5)
